# ─── HYPERLINK configuration ────────────────────────────────────────────────
# Copy to .env (optional). Every value below is also settable as a shell env var.

# Network -------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# AI ------------------------------------------------------------------------
# Which AI backend the agents reason with. Currently: "ollama".
AI_PROVIDER=ollama

# Ollama local API. Nothing about the model is hardcoded in the architecture —
# swap OLLAMA_MODEL for any model you have pulled (`ollama list`).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Per-request timeout in ms for a single AI call.
AI_TIMEOUT_MS=25000

# If the AI backend is unreachable or returns unusable output, fall back to the
# built-in deterministic reasoner so a live demo never dies on stage.
# Set to "false" to make the agents fail loudly instead.
AI_FALLBACK=true

# Presentation --------------------------------------------------------------
# Extra milliseconds of dwell on each pipeline stage, so an audience can read
# the transitions. 0 = as fast as the machines can go.
STAGE_DELAY_MS=420
